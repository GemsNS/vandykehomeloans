# PostgreSQL connection string (postgres.js / Drizzle)
# Required in production for live rates, brokers, and lead storage.
DATABASE_URL=postgres://user:password@localhost:5432/vandyke

# Admin portal credentials (/admin)
# Use a strong unique password in production.
ADMIN_PASSWORD=change-me

# Long random secret used to sign admin session cookies.
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
