# PostgreSQL connection string (postgres.js / Drizzle)
# Required in production for live rates, brokers, and lead storage.
# Lives only on the server at: /var/www/vandykehomeloan.net/backend/.env
DATABASE_URL=postgres://vandyke:password@127.0.0.1:5432/vandyke

# Admin portal credentials (/admin)
ADMIN_PASSWORD=change-me

# Long random secret used to sign admin session cookies.
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Bind localhost only — unique port on this VM (do not collide with other PM2 apps)
PORT=3010
HOSTNAME=127.0.0.1
NODE_ENV=production

# Optional: absolute path to the Node binary PM2 should run (overrides NVM default).
# Use when your compatible Node is not at ~/.nvm/versions/node/v24.16.0/bin/node
# NODE_INTERPRETER=/path/to/your/node

# Optional bearer token for /api/cron/sync-rates (recommended in production)
# Generate with: openssl rand -base64 32
RATES_SYNC_SECRET=

# Minimum interval between NAF rate pulls (ms). Default: 1800000 (30 minutes)
NAF_RATES_SYNC_INTERVAL_MS=1800000
